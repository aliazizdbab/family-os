{
  "name": "family-os",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Family OS - Arabic RTL offline-first PWA for family grocery lists, requests, budget and AI assistant",
  "scripts": {
    "test": "eslint . && node --test tests/*.test.js tests/sync.e2e.js",
    "test:unit": "node --test tests/schema.test.js tests/store.test.js tests/rules.test.js tests/sync.e2e.js",
    "test:e2e": "node --test tests/pwa.e2e.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"public/**/*.{js,css,html}\" \"tests/**/*.js\" \"tools/*.{js,html}\"",
    "format:check": "prettier --check \"public/**/*.{js,css,html}\" \"tests/**/*.js\" \"tools/*.{js,html}\"",
    "serve": "npx --yes serve public -l 5000",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,database,hosting",
    "bump": "node tools/bump-version.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "firebase": "^13.1.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1"
  }
}
